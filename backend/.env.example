# ── DocAgent environment variables ───────────────────────────────────────────
# Copy this to backend/.env and fill in your values. NEVER commit .env.
# Every variable the backend reads is listed here; a commented line shows the
# default. Keep comments on their own lines: docker-compose's env_file does not
# strip a comment written after a value.

# ── App ───────────────────────────────────────────────────────────────────────
# development | staging | production
ENVIRONMENT=development
DEBUG=true
# APP_NAME=DocAgent
# APP_VERSION=2.0.0

# ── Auth ──────────────────────────────────────────────────────────────────────
# Placeholder: production refuses to boot on it. Generate: openssl rand -hex 32
SECRET_KEY=change-me-use-openssl-rand-hex-32
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=480

# First administrator, created once at boot when no administrator exists.
# Remove the password variable right after the first successful boot.
# Surrounding whitespace is stripped before validation and hashing.
# DOCAGENT_BOOTSTRAP_ADMIN_USERNAME=<operator-selected-username>
# DOCAGENT_BOOTSTRAP_ADMIN_PASSWORD=<unique-password-at-least-15-characters>
# DOCAGENT_BOOTSTRAP_ADMIN_DISPLAY_NAME=<optional-display-name>

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://docagent:docagent@localhost:5432/docagent
# SQLite (quick dev, no Postgres needed):
# DATABASE_URL=sqlite:///./storage/docagent.db

# ── LLM ───────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_key_here
PRIMARY_LLM=gemini
# Providers tried in order after PRIMARY_LLM (comma-separated; none implemented yet)
# LLM_FALLBACKS=
# GEMINI_MODEL=gemini-2.5-flash
# BATCH_SIZE=5
# Seconds between documents in a job:
# RATE_LIMIT_DELAY=2.0
# MAX_RETRIES=3

# ── OCR ───────────────────────────────────────────────────────────────────────
# Path to the tesseract binary when it is not on PATH:
# TESSERACT_CMD=

# ── Upload limits (positive integers; invalid values use these defaults) ─────
# MAX_UPLOAD_SIZE_MB also accepts the name MAX_FILE_SIZE_MB.
MAX_UPLOAD_SIZE_MB=50
MAX_PDF_PAGES=200
MAX_IMAGE_PIXELS=50000000
# MAX_FILES_PER_BATCH=100

# ── Storage ───────────────────────────────────────────────────────────────────
# local | s3
STORAGE_BACKEND=local
# LOCAL_UPLOAD_DIR=./storage/uploads
# LOCAL_OUTPUT_DIR=./storage/outputs
# LOCAL_SCHEMAS_DIR=./storage/schemas

# S3 / Cloudflare R2 (docs/R2-SETUP.md):
# STORAGE_BACKEND=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=auto
# S3_BUCKET=docagent-files
# S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated or a JSON list; also accepts the name CORS_ORIGINS. Default *.
# ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# ── Demo accounts ─────────────────────────────────────────────────────────────
# Comma-separated client ids treated as demo tenants:
# DEMO_CLIENT_IDS=
# DEMO_MAX_MB=10
# DEMO_MAX_UPLOADS=20
# DEMO_UPLOADS_ENABLED=true
# ISO-8601 UTC; a demo account's history before it is hidden:
# DEMO_HISTORY_CUTOFF=

# ── Redis / Celery (not used yet) ─────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Frontend (frontend/.env.local, not this file) ─────────────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:8000
# BACKEND_URL=http://localhost:8000
