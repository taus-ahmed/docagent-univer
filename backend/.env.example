# ── DocAgent v2 Environment Variables ─────────────────────────────────────────
# Copy this to .env and fill in your values.
# NEVER commit .env to git.

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-use-openssl-rand-hex-32

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL (production):
DATABASE_URL=postgresql://docagent:docagent@localhost:5432/docagent

# SQLite (quick dev, no Postgres needed):
# DATABASE_URL=sqlite:///./storage/docagent.db

# ── LLM ───────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_key_here
PRIMARY_LLM=gemini
# Providers tried in order after PRIMARY_LLM (comma-separated; none implemented yet)
# LLM_FALLBACKS=

# Upload validation (positive integers; invalid values use these safe defaults)
MAX_UPLOAD_SIZE_MB=50
MAX_PDF_PAGES=200
MAX_IMAGE_PIXELS=50000000

# Model overrides (optional — defaults are fine):
# GEMINI_MODEL=gemini-2.5-flash

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_BACKEND=local
# LOCAL_UPLOAD_DIR=./storage/uploads
# LOCAL_OUTPUT_DIR=./storage/outputs
# LOCAL_SCHEMAS_DIR=./storage/schemas

# S3 / Cloudflare R2 (Phase 3):
# STORAGE_BACKEND=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=auto
# S3_BUCKET=docagent-files
# S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com

# ── Redis / Celery (Phase 4) ───────────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── CORS ──────────────────────────────────────────────────────────────────────
# Add your frontend URLs:
# ALLOWED_ORIGINS=["http://localhost:3000","https://docagent.vercel.app"]
