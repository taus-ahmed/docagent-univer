# Railway service variables for a production deploy (docs/DEPLOY-RUNBOOK.md).
# Every variable the backend reads, with its default, is in backend/.env.example.
# Placeholder values only; never commit real values.

# Database (Railway provides this with the PostgreSQL service)
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# LLM
GEMINI_API_KEY=your_gemini_key_here
PRIMARY_LLM=gemini

# Auth. Placeholder: production refuses to boot on it. Generate: openssl rand -hex 32
SECRET_KEY=change-me-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# One-time first-administrator bootstrap (no defaults; remove the password
# variable immediately after the first administrator is created)
# DOCAGENT_BOOTSTRAP_ADMIN_USERNAME=<operator-selected-username>
# DOCAGENT_BOOTSTRAP_ADMIN_PASSWORD=<unique-password-at-least-15-characters>
# Surrounding whitespace is stripped before validation and hashing.
# DOCAGENT_BOOTSTRAP_ADMIN_DISPLAY_NAME=<optional-display-name>

# Storage (local, or s3 for Cloudflare R2: docs/R2-SETUP.md)
STORAGE_BACKEND=local

# App
DEBUG=false
ENVIRONMENT=production
MAX_FILES_PER_BATCH=20
MAX_FILE_SIZE_MB=50
MAX_PDF_PAGES=200
MAX_IMAGE_PIXELS=50000000
# CORS_ORIGINS=https://your-frontend.vercel.app

# Frontend (Vercel project variable)
NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app
